// Reglas para la app control-inject

// Documento usuario de la app
match /apps/control-inject/users/{userId} {
  allow read, write: if isAuth() && request.auth.uid == userId;
}

// Patrones del usuario
match /apps/control-inject/users/{userId}/patrones/{patronId} {
  allow read, write: if isAuth() && request.auth.uid == userId;
}
match /apps/control-inject/usage_logs/{docId} {
  allow create: if request.auth != null;
  allow read:   if request.auth != null;
}